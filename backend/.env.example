DATABASE_URL=postgres://user:pass@localhost:5432/sigit

PORT=3000
GIT_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_DAYS=7
NODE_ENV=development
SIGIT_PROJECTS_ROOT=./data/projects
ENCRYPTION_KEYS={"v1":"<hex-32-byte-key>"}

# --- Compose deployment (compose.yaml reads these too; see README "Deployment") ---
# Postgres container credentials (DATABASE_URL above is overridden inside the container).
POSTGRES_USER=sigit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sigit

# Public address served by Caddy. SITE_SCHEME=http -> plain HTTP (localhost/testing);
# SITE_SCHEME=https + domain -> automatic Let's Encrypt HTTPS.
SITE_ADDRESS=localhost
SITE_SCHEME=http

# Optional first-run admin bootstrap (entrypoint creates the admin when the users table is empty).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional MinIO profile (podman-compose --profile minio).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=sigit
