{
  "name": "sigit-api",
  "version": "0.1.0",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun run src/cli/custom-build.ts",
    "test": "bun test",
    "test:build": "bun run src/cli/build-smoke.ts",
    "db:generate": "bun run src/db/migrations/migration-generator.ts",
    "db:validate": "bun run src/db/migrations/migration-generator.ts --validate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:create-admin": "bun run src/cli/create-admin.ts",
    "db:reset-password": "bun run src/cli/reset-password.ts",
    "db:reencrypt": "bun run src/cli/reencrypt-secrets.ts",
    "e2e:lfs": "bun run src/cli/e2e-lfs.ts",
    "env:decrypt": "sops --decrypt --input-type dotenv --output-type dotenv .env.sops > .env",
    "env:encrypt": "sops --encrypt --input-type dotenv --output-type dotenv .env > .env.sops"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@clack/prompts": "^1.7.0",
    "@hono/zod-openapi": "1.5.2",
    "@scalar/hono-api-reference": "^0.11.12",
    "drizzle-orm": "^0.45.2",
    "hono": "4.13.1",
    "postgres": "^3.4.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
